{
  "$description": "Design Token 単一真実源。primitive は semantic からのみ参照する。CSS に出力されるのは semantic のみ。",
  "primitive": {
    "color": {
      "neutral": {
        "0":   { "$type": "color", "$value": "#ffffff" },
        "50":  { "$type": "color", "$value": "#f7f7f8" },
        "100": { "$type": "color", "$value": "#ededf0" },
        "200": { "$type": "color", "$value": "#d9d9df" },
        "400": { "$type": "color", "$value": "#8b8b96" },
        "600": { "$type": "color", "$value": "#55555f" },
        "800": { "$type": "color", "$value": "#26262d" },
        "900": { "$type": "color", "$value": "#151519" },
        "1000":{ "$type": "color", "$value": "#000000" }
      },
      "brand": {
        "100": { "$type": "color", "$value": "#dbe7ff" },
        "500": { "$type": "color", "$value": "#2f5cff" },
        "600": { "$type": "color", "$value": "#2247d6" },
        "700": { "$type": "color", "$value": "#1a35a3" }
      },
      "danger": {
        "100": { "$type": "color", "$value": "#ffe0e0" },
        "500": { "$type": "color", "$value": "#d92d20" },
        "600": { "$type": "color", "$value": "#b42318" }
      },
      "success": {
        "500": { "$type": "color", "$value": "#0f9d58" }
      }
    },
    "size": {
      "0":  { "$type": "dimension", "$value": "0" },
      "4":  { "$type": "dimension", "$value": "0.25rem" },
      "8":  { "$type": "dimension", "$value": "0.5rem" },
      "12": { "$type": "dimension", "$value": "0.75rem" },
      "16": { "$type": "dimension", "$value": "1rem" },
      "20": { "$type": "dimension", "$value": "1.25rem" },
      "24": { "$type": "dimension", "$value": "1.5rem" },
      "32": { "$type": "dimension", "$value": "2rem" },
      "40": { "$type": "dimension", "$value": "2.5rem" },
      "48": { "$type": "dimension", "$value": "3rem" },
      "64": { "$type": "dimension", "$value": "4rem" },
      "80": { "$type": "dimension", "$value": "5rem" },
      "96": { "$type": "dimension", "$value": "6rem" }
    },
    "font": {
      "sans": { "$type": "fontFamily", "$value": "'InterVariable', system-ui, sans-serif" },
      "mono": { "$type": "fontFamily", "$value": "'JetBrainsMono', ui-monospace, monospace" }
    }
  },

  "semantic": {
    "color": {
      "text-primary": {
        "$type": "color",
        "$value": "{primitive.color.neutral.900}",
        "$extensions": { "mode": { "dark": "{primitive.color.neutral.50}" } },
        "$description": "本文・見出しの既定色"
      },
      "text-secondary": {
        "$type": "color",
        "$value": "{primitive.color.neutral.600}",
        "$extensions": { "mode": { "dark": "{primitive.color.neutral.400}" } },
        "$description": "補足テキスト・キャプション"
      },
      "text-inverse": {
        "$type": "color",
        "$value": "{primitive.color.neutral.0}",
        "$extensions": { "mode": { "dark": "{primitive.color.neutral.900}" } },
        "$description": "濃色背景上のテキスト"
      },
      "text-disabled": {
        "$type": "color",
        "$value": "{primitive.color.neutral.400}",
        "$extensions": { "mode": { "dark": "{primitive.color.neutral.600}" } },
        "$description": "disabled 状態のテキスト"
      },
      "surface-base": {
        "$type": "color",
        "$value": "{primitive.color.neutral.0}",
        "$extensions": { "mode": { "dark": "{primitive.color.neutral.900}" } },
        "$description": "ページ背景"
      },
      "surface-raised": {
        "$type": "color",
        "$value": "{primitive.color.neutral.50}",
        "$extensions": { "mode": { "dark": "{primitive.color.neutral.800}" } },
        "$description": "Card / Modal など一段上のレイヤ"
      },
      "border-default": {
        "$type": "color",
        "$value": "{primitive.color.neutral.200}",
        "$extensions": { "mode": { "dark": "{primitive.color.neutral.600}" } },
        "$description": "区切り線・入力枠"
      },
      "action-primary": {
        "$type": "color",
        "$value": "{primitive.color.brand.500}",
        "$extensions": { "mode": { "dark": "{primitive.color.brand.500}" } },
        "$description": "主要ボタン・リンクの背景"
      },
      "action-primary-hover": {
        "$type": "color",
        "$value": "{primitive.color.brand.600}",
        "$extensions": { "mode": { "dark": "{primitive.color.brand.600}" } },
        "$description": "主要アクションの hover"
      },
      "action-primary-active": {
        "$type": "color",
        "$value": "{primitive.color.brand.700}",
        "$extensions": { "mode": { "dark": "{primitive.color.brand.700}" } },
        "$description": "主要アクションの active（押下中）"
      },
      "action-subtle": {
        "$type": "color",
        "$value": "{primitive.color.brand.100}",
        "$extensions": { "mode": { "dark": "{primitive.color.neutral.800}" } },
        "$description": "secondary / ghost の hover 背景"
      },
      "state-danger": {
        "$type": "color",
        "$value": "{primitive.color.danger.500}",
        "$extensions": { "mode": { "dark": "{primitive.color.danger.500}" } },
        "$description": "エラー表示・破壊的アクション"
      },
      "state-danger-surface": {
        "$type": "color",
        "$value": "{primitive.color.danger.100}",
        "$extensions": { "mode": { "dark": "{primitive.color.danger.600}" } },
        "$description": "エラーメッセージの背景"
      },
      "state-success": {
        "$type": "color",
        "$value": "{primitive.color.success.500}",
        "$extensions": { "mode": { "dark": "{primitive.color.success.500}" } },
        "$description": "成功表示"
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{primitive.color.brand.600}",
        "$extensions": { "mode": { "dark": "{primitive.color.brand.500}" } },
        "$description": "フォーカスインジケータ。非表示化禁止（constitution.md「10.1.2」）"
      }
    },

    "space": {
      "0":  { "$type": "dimension", "$value": "{primitive.size.0}",  "$description": "リセット用" },
      "1":  { "$type": "dimension", "$value": "{primitive.size.4}",  "$description": "アイコンと文字の間" },
      "2":  { "$type": "dimension", "$value": "{primitive.size.8}",  "$description": "インライン要素間" },
      "3":  { "$type": "dimension", "$value": "{primitive.size.12}", "$description": "入力欄の内側左右" },
      "4":  { "$type": "dimension", "$value": "{primitive.size.16}", "$description": "既定のコンポーネント内側余白" },
      "5":  { "$type": "dimension", "$value": "{primitive.size.24}", "$description": "Card 内側" },
      "6":  { "$type": "dimension", "$value": "{primitive.size.32}", "$description": "要素グループ間" },
      "7":  { "$type": "dimension", "$value": "{primitive.size.48}", "$description": "サブセクション間" },
      "8":  { "$type": "dimension", "$value": "{primitive.size.80}", "$description": "セクション間（Desktop）" },
      "section-gap-mobile": { "$type": "dimension", "$value": "{primitive.size.48}", "$description": "セクション間（Mobile）" }
    },

    "font-family": {
      "body":    { "$type": "fontFamily", "$value": "{primitive.font.sans}", "$description": "本文。self-host 必須" },
      "display": { "$type": "fontFamily", "$value": "{primitive.font.sans}", "$description": "見出し" },
      "mono":    { "$type": "fontFamily", "$value": "{primitive.font.mono}", "$description": "コード" }
    },
    "font-size": {
      "100": { "$type": "dimension", "$value": "0.8125rem", "$description": "caption" },
      "200": { "$type": "dimension", "$value": "0.9375rem", "$description": "body-sm" },
      "300": { "$type": "dimension", "$value": "1rem",      "$description": "body" },
      "400": { "$type": "dimension", "$value": "1.25rem",   "$description": "h3" },
      "500": { "$type": "dimension", "$value": "1.75rem",   "$description": "h2" },
      "600": { "$type": "dimension", "$value": "clamp(2rem, 1.4rem + 2.4vw, 3rem)", "$description": "h1 / hero" }
    },
    "font-weight": {
      "regular": { "$type": "fontWeight", "$value": "400" },
      "medium":  { "$type": "fontWeight", "$value": "500" },
      "bold":    { "$type": "fontWeight", "$value": "700" }
    },
    "line-height": {
      "tight":  { "$type": "number", "$value": "1.2",  "$description": "見出し" },
      "normal": { "$type": "number", "$value": "1.6",  "$description": "本文" }
    },
    "letter-spacing": {
      "tight":  { "$type": "dimension", "$value": "-0.02em", "$description": "大見出し" },
      "normal": { "$type": "dimension", "$value": "0" }
    },

    "radius": {
      "none": { "$type": "dimension", "$value": "0" },
      "sm":   { "$type": "dimension", "$value": "0.25rem", "$description": "Input / Tag" },
      "md":   { "$type": "dimension", "$value": "0.5rem",  "$description": "Button / Card" },
      "lg":   { "$type": "dimension", "$value": "1rem",    "$description": "Modal / Hero 画像" },
      "full": { "$type": "dimension", "$value": "9999px",  "$description": "Avatar / Pill" }
    },

    "shadow": {
      "sm": {
        "$type": "shadow",
        "$value": "0 1px 2px rgb(0 0 0 / 0.06)",
        "$extensions": { "mode": { "dark": "0 1px 2px rgb(0 0 0 / 0.5)" } },
        "$description": "Card の既定"
      },
      "md": {
        "$type": "shadow",
        "$value": "0 4px 12px rgb(0 0 0 / 0.08)",
        "$extensions": { "mode": { "dark": "0 4px 12px rgb(0 0 0 / 0.6)" } },
        "$description": "hover 時の浮き"
      },
      "lg": {
        "$type": "shadow",
        "$value": "0 16px 40px rgb(0 0 0 / 0.14)",
        "$extensions": { "mode": { "dark": "0 16px 40px rgb(0 0 0 / 0.7)" } },
        "$description": "Modal / Dropdown"
      }
    },

    "duration": {
      "instant": { "$type": "duration", "$value": "0ms",   "$description": "reduced-motion 時の代替値" },
      "fast":    { "$type": "duration", "$value": "120ms", "$description": "色・不透明度の変化" },
      "normal":  { "$type": "duration", "$value": "200ms", "$description": "位置・大きさの変化" },
      "slow":    { "$type": "duration", "$value": "320ms", "$description": "Modal の出入り" }
    },
    "easing": {
      "standard":   { "$type": "cubicBezier", "$value": "cubic-bezier(0.2, 0, 0.2, 1)" },
      "decelerate": { "$type": "cubicBezier", "$value": "cubic-bezier(0, 0, 0.2, 1)", "$description": "出現" },
      "accelerate": { "$type": "cubicBezier", "$value": "cubic-bezier(0.4, 0, 1, 1)", "$description": "退出" }
    },

    "z": {
      "base":     { "$type": "number", "$value": "0" },
      "dropdown": { "$type": "number", "$value": "100" },
      "sticky":   { "$type": "number", "$value": "200" },
      "overlay":  { "$type": "number", "$value": "300" },
      "modal":    { "$type": "number", "$value": "400" },
      "toast":    { "$type": "number", "$value": "500" }
    },

    "container": {
      "content": { "$type": "dimension", "$value": "44rem", "$description": "本文カラム最大幅（約 704px）" },
      "wide":    { "$type": "dimension", "$value": "75rem", "$description": "ページ最大幅（1200px）" },
      "gutter":  { "$type": "dimension", "$value": "{primitive.size.20}", "$description": "画面端の余白（Mobile）" }
    }
  },

  "breakpoint": {
    "$description": "CSS カスタムプロパティはメディアクエリで使えないため、@custom-media として別ファイルに出力される。src では必ず --bp-* を使う。",
    "sm": { "$type": "dimension", "$value": "30rem", "$description": "480px / 大きめのスマートフォン横" },
    "md": { "$type": "dimension", "$value": "48rem", "$description": "768px / タブレット縦" },
    "lg": { "$type": "dimension", "$value": "64rem", "$description": "1024px / タブレット横・小型ノート" },
    "xl": { "$type": "dimension", "$value": "80rem", "$description": "1280px / デスクトップ" }
  }
}
